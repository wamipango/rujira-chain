{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConfigResponse",
  "type": "object",
  "required": [
    "executor",
    "owner",
    "target_addresses",
    "target_denoms"
  ],
  "properties": {
    "executor": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "target_addresses": {
      "type": "array",
      "items": {
        "type": "array",
        "items": [
          {
            "type": "string"
          },
          {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          }
        ],
        "maxItems": 2,
        "minItems": 2
      }
    },
    "target_denoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
