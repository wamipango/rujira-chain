{
  "contract_name": "rujira-ghost-borrow",
  "contract_version": "0.0.0",
  "idl_version": "1.0.0",
  "instantiate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InstantiateMsg",
    "type": "object",
    "required": [
      "registry"
    ],
    "properties": {
      "registry": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "execute": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ExecuteMsg",
    "oneOf": [
      {
        "description": "Create a new, update or close an existing position Set the target amounts. If both set to zero, position will be closed Surplus is returned to the sender",
        "type": "object",
        "required": [
          "manage"
        ],
        "properties": {
          "manage": {
            "type": "object",
            "required": [
              "collateral_target",
              "debt_target"
            ],
            "properties": {
              "collateral_action": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/Action"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "collateral_target": {
                "description": "Target collateral amount",
                "allOf": [
                  {
                    "$ref": "#/definitions/Uint128"
                  }
                ]
              },
              "debt_action": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/Action"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "debt_target": {
                "description": "Target borrow amount",
                "allOf": [
                  {
                    "$ref": "#/definitions/Uint128"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Transfer debt to another borrow position, optionally swapping collateral and moving it at the same time",
        "type": "object",
        "required": [
          "transfer"
        ],
        "properties": {
          "transfer": {
            "type": "object",
            "required": [
              "debt_shares",
              "destination"
            ],
            "properties": {
              "collateral": {
                "description": "An optional execution step that will deduct collateral from the current position, exchange it for the collateral of the destination, and transfer them all together",
                "anyOf": [
                  {
                    "$ref": "#/definitions/Action"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "debt_shares": {
                "description": "Amount of the Vault's debt shares to transfer.",
                "allOf": [
                  {
                    "$ref": "#/definitions/Uint128"
                  }
                ]
              },
              "destination": {
                "description": "ghost-borrow contract address destination this address must be registered on ghost-registry for the transfer to be valid",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "callback"
        ],
        "properties": {
          "callback": {
            "$ref": "#/definitions/CallbackMsg"
          }
        },
        "additionalProperties": false
      }
    ],
    "definitions": {
      "Action": {
        "type": "object",
        "required": [
          "amount",
          "contract",
          "msg"
        ],
        "properties": {
          "amount": {
            "$ref": "#/definitions/Uint128"
          },
          "contract": {
            "type": "string"
          },
          "msg": {
            "$ref": "#/definitions/Binary"
          }
        },
        "additionalProperties": false
      },
      "Binary": {
        "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
        "type": "string"
      },
      "CallbackMsg": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "manage_collateral"
            ],
            "properties": {
              "manage_collateral": {
                "type": "object",
                "required": [
                  "collateral_target",
                  "debt_target",
                  "funds"
                ],
                "properties": {
                  "collateral_target": {
                    "$ref": "#/definitions/Uint128"
                  },
                  "debt_action": {
                    "anyOf": [
                      {
                        "$ref": "#/definitions/Action"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "debt_target": {
                    "$ref": "#/definitions/Uint128"
                  },
                  "funds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/Coin"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "manage_debt"
            ],
            "properties": {
              "manage_debt": {
                "type": "object",
                "required": [
                  "collateral_target",
                  "debt_target",
                  "funds"
                ],
                "properties": {
                  "collateral_target": {
                    "$ref": "#/definitions/Uint128"
                  },
                  "debt_target": {
                    "$ref": "#/definitions/Uint128"
                  },
                  "funds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/Coin"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "transfer_collateral"
            ],
            "properties": {
              "transfer_collateral": {
                "type": "object",
                "required": [
                  "debt_shares",
                  "destination"
                ],
                "properties": {
                  "debt_shares": {
                    "$ref": "#/definitions/Uint128"
                  },
                  "destination": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "Coin": {
        "type": "object",
        "required": [
          "amount",
          "denom"
        ],
        "properties": {
          "amount": {
            "$ref": "#/definitions/Uint128"
          },
          "denom": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Uint128": {
        "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
        "type": "string"
      }
    }
  },
  "query": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "QueryMsg",
    "oneOf": [
      {
        "type": "object",
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "position"
        ],
        "properties": {
          "position": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    ]
  },
  "migrate": null,
  "sudo": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SudoMsg",
    "type": "string",
    "enum": []
  },
  "responses": {
    "config": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ConfigResponse",
      "type": "object",
      "required": [
        "collateral_denom",
        "debt_denom",
        "orca_addr",
        "vault_addr"
      ],
      "properties": {
        "collateral_denom": {
          "type": "string"
        },
        "debt_denom": {
          "type": "string"
        },
        "orca_addr": {
          "type": "string"
        },
        "vault_addr": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "position": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PositionResponse",
      "type": "object",
      "required": [
        "collateral",
        "debt_amount",
        "debt_shares",
        "ltv",
        "owner"
      ],
      "properties": {
        "collateral": {
          "$ref": "#/definitions/Uint128"
        },
        "debt_amount": {
          "$ref": "#/definitions/Uint128"
        },
        "debt_shares": {
          "$ref": "#/definitions/Uint128"
        },
        "ltv": {
          "$ref": "#/definitions/Decimal"
        },
        "owner": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Decimal": {
          "description": "A fixed-point decimal value with 18 fractional digits, i.e. Decimal(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 340282366920938463463.374607431768211455 (which is (2^128 - 1) / 10^18)",
          "type": "string"
        },
        "Uint128": {
          "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
          "type": "string"
        }
      }
    },
    "status": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StatusResponse",
      "type": "object",
      "required": [
        "collateral_amount",
        "collateral_denom",
        "debt_amount",
        "debt_denom",
        "debt_limit",
        "debt_rate",
        "max_ltv",
        "price"
      ],
      "properties": {
        "collateral_amount": {
          "description": "Total amount of collateral deposited",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "collateral_denom": {
          "type": "string"
        },
        "debt_amount": {
          "description": "Total amount of debt issued",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "debt_denom": {
          "type": "string"
        },
        "debt_limit": {
          "description": "Current debt limit",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "debt_rate": {
          "description": "Current debt rate",
          "allOf": [
            {
              "$ref": "#/definitions/Decimal"
            }
          ]
        },
        "max_ltv": {
          "description": "Maximum LTV value before the contract is allowed to begin liqudiating collateral",
          "allOf": [
            {
              "$ref": "#/definitions/Decimal"
            }
          ]
        },
        "price": {
          "description": "Current collateral price denmincated in debt token Adjusted for decimal delta between tokens",
          "allOf": [
            {
              "$ref": "#/definitions/Decimal"
            }
          ]
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Decimal": {
          "description": "A fixed-point decimal value with 18 fractional digits, i.e. Decimal(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 340282366920938463463.374607431768211455 (which is (2^128 - 1) / 10^18)",
          "type": "string"
        },
        "Uint128": {
          "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
          "type": "string"
        }
      }
    }
  }
}
