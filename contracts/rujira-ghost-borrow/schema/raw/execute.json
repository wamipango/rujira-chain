{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteMsg",
  "oneOf": [
    {
      "description": "Create a new, update or close an existing position Set the target amounts. If both set to zero, position will be closed Surplus is returned to the sender",
      "type": "object",
      "required": [
        "manage"
      ],
      "properties": {
        "manage": {
          "type": "object",
          "required": [
            "collateral_target",
            "debt_target"
          ],
          "properties": {
            "collateral_action": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Action"
                },
                {
                  "type": "null"
                }
              ]
            },
            "collateral_target": {
              "description": "Target collateral amount",
              "allOf": [
                {
                  "$ref": "#/definitions/Uint128"
                }
              ]
            },
            "debt_action": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Action"
                },
                {
                  "type": "null"
                }
              ]
            },
            "debt_target": {
              "description": "Target borrow amount",
              "allOf": [
                {
                  "$ref": "#/definitions/Uint128"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Transfer debt to another borrow position, optionally swapping collateral and moving it at the same time",
      "type": "object",
      "required": [
        "transfer"
      ],
      "properties": {
        "transfer": {
          "type": "object",
          "required": [
            "debt_shares",
            "destination"
          ],
          "properties": {
            "collateral": {
              "description": "An optional execution step that will deduct collateral from the current position, exchange it for the collateral of the destination, and transfer them all together",
              "anyOf": [
                {
                  "$ref": "#/definitions/Action"
                },
                {
                  "type": "null"
                }
              ]
            },
            "debt_shares": {
              "description": "Amount of the Vault's debt shares to transfer.",
              "allOf": [
                {
                  "$ref": "#/definitions/Uint128"
                }
              ]
            },
            "destination": {
              "description": "ghost-borrow contract address destination this address must be registered on ghost-registry for the transfer to be valid",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "callback"
      ],
      "properties": {
        "callback": {
          "$ref": "#/definitions/CallbackMsg"
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "Action": {
      "type": "object",
      "required": [
        "amount",
        "contract",
        "msg"
      ],
      "properties": {
        "amount": {
          "$ref": "#/definitions/Uint128"
        },
        "contract": {
          "type": "string"
        },
        "msg": {
          "$ref": "#/definitions/Binary"
        }
      },
      "additionalProperties": false
    },
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    },
    "CallbackMsg": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "manage_collateral"
          ],
          "properties": {
            "manage_collateral": {
              "type": "object",
              "required": [
                "collateral_target",
                "debt_target",
                "funds"
              ],
              "properties": {
                "collateral_target": {
                  "$ref": "#/definitions/Uint128"
                },
                "debt_action": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/Action"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "debt_target": {
                  "$ref": "#/definitions/Uint128"
                },
                "funds": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Coin"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "manage_debt"
          ],
          "properties": {
            "manage_debt": {
              "type": "object",
              "required": [
                "collateral_target",
                "debt_target",
                "funds"
              ],
              "properties": {
                "collateral_target": {
                  "$ref": "#/definitions/Uint128"
                },
                "debt_target": {
                  "$ref": "#/definitions/Uint128"
                },
                "funds": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Coin"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "transfer_collateral"
          ],
          "properties": {
            "transfer_collateral": {
              "type": "object",
              "required": [
                "debt_shares",
                "destination"
              ],
              "properties": {
                "debt_shares": {
                  "$ref": "#/definitions/Uint128"
                },
                "destination": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Coin": {
      "type": "object",
      "required": [
        "amount",
        "denom"
      ],
      "properties": {
        "amount": {
          "$ref": "#/definitions/Uint128"
        },
        "denom": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    }
  }
}
